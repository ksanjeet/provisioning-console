<?xml version="1.0"?>
<!DOCTYPE profile>
<!--
  AutoYaST profile for a minimal SLES for SAP 15 SP7 CloudStack (KVM) template.
  - Installs only from the SLE-15-SP7-Full ISO, no registration (hosts register to RMT at provisioning time).
  - Single XFS root partition as last partition so cloud-init growpart can extend it to the requested root disk size.
  - cloud-init (CloudStack datasource) injects SSH keys / user-data; qemu-guest-agent for CloudStack/KVM.
-->
<profile xmlns="http://www.suse.com/1.0/yast2ns" xmlns:config="http://www.suse.com/1.0/configns">
  <general>
    <mode>
      <confirm config:type="boolean">false</confirm>
      <final_halt config:type="boolean">true</final_halt>
      <!-- single stage only: no YaST second stage / firstboot on cloned VMs -->
      <second_stage config:type="boolean">false</second_stage>
    </mode>
    <signature-handling>
      <accept_unsigned_file config:type="boolean">false</accept_unsigned_file>
      <accept_unknown_gpg_key config:type="boolean">false</accept_unknown_gpg_key>
    </signature-handling>
  </general>

  <suse_register>
    <do_registration config:type="boolean">false</do_registration>
  </suse_register>

  <add-on>
    <add_on_products config:type="list">
      <listentry>
        <media_url><![CDATA[relurl://]]></media_url>
        <product>sle-module-basesystem</product>
        <product_dir>/Module-Basesystem</product_dir>
      </listentry>
      <listentry>
        <media_url><![CDATA[relurl://]]></media_url>
        <product>sle-module-server-applications</product>
        <product_dir>/Module-Server-Applications</product_dir>
      </listentry>
      <listentry>
        <media_url><![CDATA[relurl://]]></media_url>
        <product>sle-module-sap-applications</product>
        <product_dir>/Module-SAP-Applications</product_dir>
      </listentry>
      <listentry>
        <media_url><![CDATA[relurl://]]></media_url>
        <product>sle-module-public-cloud</product>
        <product_dir>/Module-Public-Cloud</product_dir>
      </listentry>
      <listentry>
        <media_url><![CDATA[relurl://]]></media_url>
        <product>sle-module-python3</product>
        <product_dir>/Module-Python3</product_dir>
      </listentry>
      <listentry>
        <media_url><![CDATA[relurl://]]></media_url>
        <product>sle-ha</product>
        <product_dir>/Product-HA</product_dir>
      </listentry>
    </add_on_products>
  </add-on>

  <bootloader>
    <loader_type>grub2</loader_type>
    <global>
      <timeout config:type="integer">3</timeout>
      <terminal>console serial</terminal>
      <serial>serial --unit=0 --speed=115200</serial>
      <!-- tsx=auto: checked by saptune for SAP Note 2684254 (grub:tsx), also on CPUs without TSX -->
      <append>console=tty0 console=ttyS0,115200 net.ifnames=0 quiet tsx=auto</append>
    </global>
  </bootloader>

  <partitioning config:type="list">
    <drive>
      <device>/dev/vda</device>
      <disklabel>gpt</disklabel>
      <initialize config:type="boolean">true</initialize>
      <use>all</use>
      <partitions config:type="list">
        <partition>
          <create config:type="boolean">true</create>
          <format config:type="boolean">false</format>
          <partition_id config:type="integer">263</partition_id>
          <size>8M</size>
        </partition>
        <partition>
          <create config:type="boolean">true</create>
          <format config:type="boolean">true</format>
          <filesystem config:type="symbol">xfs</filesystem>
          <mount>/</mount>
          <size>max</size>
        </partition>
      </partitions>
    </drive>
  </partitioning>

  <software>
    <products config:type="list">
      <product>SLES_SAP</product>
    </products>
    <install_recommended config:type="boolean">false</install_recommended>
    <patterns config:type="list">
      <pattern>base</pattern>
      <pattern>minimal_base</pattern>
    </patterns>
    <packages config:type="list">
      <package>kernel-default</package>
      <package>grub2</package>
      <package>grub2-i386-pc</package>
      <package>openssh</package>
      <package>sudo</package>
      <package>chrony</package>
      <package>xfsprogs</package>
      <package>lvm2</package>
      <package>rsync</package>
      <package>tar</package>
      <package>curl</package>
      <package>less</package>
      <package>vim</package>
      <package>python3</package>
      <!-- ansible-core >= 2.17 requires Python >= 3.8 on managed nodes -->
      <package>python311</package>
      <package>suseconnect-ng</package>
      <package>cloud-init</package>
      <package>cloud-init-config-suse</package>
      <package>growpart</package>
      <package>qemu-guest-agent</package>
      <package>wicked</package>
    </packages>
  </software>

  <networking>
    <keep_install_network config:type="boolean">false</keep_install_network>
    <interfaces config:type="list">
      <interface>
        <bootproto>dhcp</bootproto>
        <name>eth0</name>
        <startmode>auto</startmode>
      </interface>
    </interfaces>
  </networking>

  <firewall>
    <enable_firewall config:type="boolean">false</enable_firewall>
    <start_firewall config:type="boolean">false</start_firewall>
  </firewall>

  <services-manager>
    <default_target>multi-user</default_target>
    <services>
      <enable config:type="list">
        <service>sshd</service>
        <service>chronyd</service>
        <service>cloud-init-local</service>
        <service>cloud-init</service>
        <service>cloud-config</service>
        <service>cloud-final</service>
      </enable>
    </services>
  </services-manager>

  <timezone>
    <timezone>Etc/UTC</timezone>
    <hwclock>UTC</hwclock>
  </timezone>

  <keyboard>
    <keymap>english-us</keymap>
  </keyboard>
  <language>
    <language>en_US</language>
  </language>

  <users config:type="list">
    <user>
      <username>root</username>
      <!-- Locked: access only via SSH keys injected by cloud-init -->
      <user_password>!</user_password>
      <encrypted config:type="boolean">true</encrypted>
    </user>
  </users>
</profile>
